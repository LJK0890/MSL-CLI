<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MSL_CLI</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Program.cs / CommandParser.cs 直接使用 DI 容器，显式声明依赖，
         避免上游包调整依赖图时突然编译失败（版本与当前解析结果一致） -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="McQuery.Net" Version="2.0.0" />
    <PackageReference Include="OpenAI" Version="2.12.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- 默认配置模板：随程序发布，供 %APPDATA% 下无用户配置时回退使用 -->
    <None Update="config.default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
